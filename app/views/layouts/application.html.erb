<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Vistoria Web" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <!-- CDN do Tailwind CSS -->
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@latest/dist/tailwind.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
  </head>
  <body class="flex w-screen h-screen overflow-hidden bg-gray-100 text-zinc-600 dark:bg-zinc-800 dark:text-gray-200 antialiased">
    <div class="flex flex-col w-16 md:w-full max-w-72 h-full p-4 items-start gap-12 border-r dark:border-r-zinc-700">
      <header class="hidden md:flex w-full h-auto gap-2 items-end"> 
        <div class="w-16 h-16 bg-gray-300 opacity-80 rounded-full hover:drop-shadow-2xl cursor-pointer transition-all duration-200 self-center justify-self-center"></div>
        <p><%= link_to "Vistoria Web", root_path, class: "text-blue-500 font-semibold text-3xl tracking-tighter" %></p>
      </header>
      <nav class="flex flex-col w-full gap-4">
        <div class="flex flex-col gap-4">
          <p class="hidden md:block text-sm font-regular">Acesso rápido</p>
          <i data-lucide="rocket" class="md:hidden text-blue-500 w-8 h-8 self-center mb-8"></i>
          <div class="pl-0 md:pl-4 flex flex-col gap-6">
            <%= link_to home_index_path, class: "#{current_page?(home_index_path) && 'text-blue-500'}" do %>
              <div class="flex items-center justify-center gap-2 hover:text-blue-500 transition-all duration-200 cursor-pointer">
                <i data-lucide="home" class="w-5 h-5"></i>
                <p class="hidden md:block text-sm font-semibold w-full list-none">Início</p>
              </div>
            <% end %>
            <%= link_to root_path, class: "#{current_page?(root_path) && 'text-blue-500'}" do %>
              <div class="flex items-center justify-center gap-2 hover:text-blue-500 transition-all duration-200 cursor-pointer">
                <i data-lucide="user" class="w-5 h-5"></i>
                <p class="hidden md:block text-sm font-semibold w-full list-none">Usuários</p>
              </div>
            <% end %>
            <%= link_to new_user_path, class: "#{current_page?(new_user_path) && 'text-blue-500'}" do %>
              <div class="flex items-center justify-center gap-2 hover:text-blue-500 transition-all duration-200 cursor-pointer">
                <i data-lucide="diamond-plus" class="w-5 h-5"></i>
                <p class="hidden md:block text-sm font-semibold w-full list-none">Novo usuário</p>
              </div>
            <% end %>
          </div>
        </div>
      </nav>
    </div>
    <div class="flex flex-1 w-full h-full">
      <%= yield %>
    </div>
    
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        lucide.createIcons();
      });
    </script>
  </body>
</html>
