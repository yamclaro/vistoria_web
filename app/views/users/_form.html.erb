<%= form_with(model: user) do |form| %>
  <% if user.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h2>

      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col w-full items-start gap-6">
    <div class="flex w-full flex-col gap-2">
      <%= form.label :name, style: "display: block", class: 'text-gray-500 font-medium' %>
      <%= form.text_field :name, class: 'border border-gray-200 rounded-md p-1' %>
    </div>
  
    <div class="flex w-full flex-col gap-2">
      <%= form.label :email, style: "display: block", class: 'text-gray-500 font-medium' %>
      <%= form.text_field :email, class: 'border border-gray-200 rounded-md p-1' %>
    </div>
  
    <div class="flex w-full flex-col gap-2">
      <%= form.label :idade, style: "display: block", class: 'text-gray-500 font-medium' %>
      <%= form.number_field :age, class: 'border border-gray-200 rounded-md p-1' %>
    </div>
    
    <% if current_page?(new_user_path) %>
      <div class="flex w-full items-center justify-end self-end">
          <%= form.submit "Cadastrar", class: 'p-2 px-4 rounded-lg text-white bg-green-500 cursor-pointer hover:brightness-95 transition duration-200' %>
      </div> 
    <% end %>
    
  </div>
<% end %>
