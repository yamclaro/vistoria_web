<%= form_with(model: user) do |form| %>
  <% if user.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h2>

      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col items-start gap-6">
    <div class="flex flex-col items-start gap-2">
      <%= form.label :name, style: "display: block", class: 'text-gray-500 font-medium' %>
      <%= form.text_field :name, class: 'border border-gray-200 rounded-md p-1' %>
    </div>
  
    <div class="flex flex-col items-start gap-2 ">
      <%= form.label :email, style: "display: block", class: 'text-gray-500 font-medium' %>
      <%= form.text_field :email, class: 'border border-gray-200 rounded-md p-1' %>
    </div>
  
    <div class="flex flex-col items-start gap-2 ">
      <%= form.label :age, style: "display: block", class: 'text-gray-500 font-medium' %>
      <%= form.number_field :age, class: 'border border-gray-200 rounded-md p-1' %>
    </div>
    
    <div>
      <%= form.submit "Cadastrar", class: 'p-2 px-4 flex items-center justify-center rounded-lg text-white bg-green-500 cursor-pointer' %>
    </div>
  </div>
<% end %>
