<div id="<%= dom_id user %>" class="flex flex-col gap-2">
  <div class="flex flex-col items-start">
    <strong class="text-sm">Name</strong>
    <p class="text-base capitalize font-light"><%= user.name%></p>
  </div>

  <div class="flex flex-col items-start">
    <strong class="text-sm">Email</strong>
    <p class="text-base font-light"><%= user.email%></p>
  </div>

  <div class="flex flex-col items-start">
    <strong class="text-sm">Idade</strong>
    <p class="text-base font-light"><%= user.age%></p>
  </div>
</div>
