<% content_for :title, "Editing user" %>


<div class="flex flex-col w-full h-full items-center justify-center">
  <div class="flex flex-col bg-white h-auto p-8 w-[400px] rounded-lg shadow-lg gap-12">
  <p class="text-lg font-semibold">Editar usuário</p>

  <%= render "form", user: @user %>

  <div class="flex items-center justify-between text-white gap-8">
    <%= link_to "Voltar", users_path, class: "py-2 px-4 w-full items-center flex justify-center rounded-lg bg-gray-500" %>
    <%= link_to "Detalhes", @user, class: "py-2 px-4 w-full items-center flex justify-center rounded-lg bg-gray-500" %>
  </div>
</div>
</div>