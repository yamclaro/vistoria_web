<div class="flex flex-1 flex-col p-4">
  
  <% content_for :title, "Usuários" %>
  
  <div class="flex w-full justify-between items-center mb-12">
    <h1 class="font-semibold text-2xl">Usuários</h1>
    
    <%= link_to "Novo usuário", new_user_path, class: "p-2 bg-blue-500 text-white rounded-md shadow-xl" %>
  </div>

  <!-- CARD'S -->
  <div class="grid grid-cols-5 gap-6 flex-wrap">
    <% @users.each do |user| %>
      <div id="users" class="w-full p-4 border border-gray-200 rounded-lg bg-white shadow hover:shadow-2xl shadow-gray-100 transition-all duration-200 flex flex-col gap-4 dark:bg-zinc-700 dark:border-none dark:shadow-none">
        <%= render user %>
        <div class="w-full flex items-center justify-end">
          <%= link_to "Mais detalhes", user, class: 'p-2 bg-blue-400 rounded-md text-sm font-normal text-white' %>
        </div>
      </div>
    <% end %>
  </div>
  <p style="color: green"><%= notice %></p>
</div>
