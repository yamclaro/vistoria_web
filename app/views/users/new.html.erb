<% content_for :title, "Novo usuário" %>
<div class="flex flex-col w-full h-full items-center justify-center">

  <div class="flex flex-col bg-white h-auto p-8 w-[400px] rounded-lg shadow-lg gap-12">
    <div class="flex w-full items-center justify-start">
      <%= link_to users_path, class: "flex items-center p-2" do %>
        <i data-lucide="chevron-left" class="mr-2"></i>
      <% end %>
      <div class="flex flex-col gap-2">
        <p class="text-lg font-semibold">Novo usuário</p>
      </div>
    </div>
  
    <%= render "form", user: @user %>
  </div>

</div>
