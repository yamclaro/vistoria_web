<p style="color: green"><%= notice %></p>


<div class="flex flex-col w-full h-full items-center justify-center">
  <div class="flex flex-col bg-white h-auto p-8 w-[400px] rounded-lg shadow-lg gap-12">
    <div class="flex items-center justify-start">
      <%= link_to users_path do %>
        <i data-lucide="chevron-left" class="mr-2"></i>
      <% end %>
      <p class="text-lg font-semibold">Detalhes do usuário</p>
    </div>
    <%= render @user %>
    <div class="flex justify-between items-center">
      <%= link_to "Editar usuário", edit_user_path(@user), class: 'p-2 rounded-lg shadow-lg bg-amber-500 text-white' %>
      <%= button_to "Deletar usuário", @user, method: :delete, class: "p-2 rounded-lg shadow-lg bg-red-500 text-white" %>
    </div>
  </div>
</div>
